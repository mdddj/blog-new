{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "unicorn", "oxc", "nextjs", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/set-state-in-effect": "off",
    "react/preserve-manual-memoization": "off",
    "react/immutability": "off"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "dist/**",
    "build/**",
    "next-env.d.ts"
  ]
}
