{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "dist/**",
    "build/**",
    "pnpm-lock.yaml",
    "package-lock.json",
    "next-env.d.ts",
    ".agents/**",
    ".claude/**",
    ".cursor/**",
    ".crush/**",
    ".junie/**",
    ".kiro/**",
    ".factory/**",
  ],
}
